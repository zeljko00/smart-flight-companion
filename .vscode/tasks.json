{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bring up development environment",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "deploy/docker-compose.yml",
        "--profile",
        "dev",
        "up",
        "--remove-orphans",
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Bring up development environment - with DB migrations",
      "type": "shell",
      "command": "docker",
      "args": [
        "compose",
        "-f",
        "deploy/docker-compose.yml",
        "--profile",
        "dev",
        "--profile",
        "migrate",
        "up",
        "--remove-orphans",
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Stop development environment",
      "type": "shell",
      "command": "docker",
      "args": [
          "compose",
          "-f",
          "deploy/docker-compose.yml",
          "--profile",
          "dev",
          "down",
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
     {
      "label": "Stop development environment - with DB migrations",
      "type": "shell",
      "command": "docker",
      "args": [
          "compose",
          "-f",
          "deploy/docker-compose.yml",
          "--profile",
          "dev",
          "--profile",
          "migrate",
          "down",
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "Clean up development environment",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "ids=$(docker ps -aq); if [ -n \"$ids\" ]; then docker rm -f $ids; else echo \"No containers to remove.\"; fi"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": false,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}