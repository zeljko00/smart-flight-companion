            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Should I arrive earlier for this flight and what should I prepare?\"\n}"
            },
            "url": "{{baseUrl}}/flights/{{flightId}}/advice"
          }
        },
        {
          "name": "Get flight by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/flights/{{flightId}}"
          }
        },
        {
          "name": "Create flight (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/flights",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"{{newFlightNumber}}\",\n  \"departureAirportIata\": \"JFK\",\n  \"arrivalAirportIata\": \"LAX\",\n  \"status\": \"Scheduled\",\n  \"terminal\": 2,\n  \"gate\": \"A5\",\n  \"airline\": \"Postman Air\",\n  \"aircraft\": \"Airbus A320\",\n  \"seatCapacity\": 180,\n  \"scheduledDepartureTime\": \"2026-12-01T10:00:00Z\",\n  \"scheduledArrivalTime\": \"2026-12-01T14:00:00Z\",\n  \"departureTime\": \"2026-12-01T10:00:00Z\",\n  \"arrivalTime\": \"2026-12-01T14:00:00Z\",\n  \"economyPrice\": 120.5,\n  \"premiumEconomyPrice\": 180.5,\n  \"businessPrice\": 320.5,\n  \"firstClassPrice\": 500.5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('flightId', json.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Update flight (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/flights/{{flightId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"{{newFlightNumber}}\",\n  \"departureAirportIata\": \"JFK\",\n  \"arrivalAirportIata\": \"LAX\",\n  \"status\": \"Delayed\",\n  \"terminal\": 3,\n  \"gate\": \"A9\",\n  \"airline\": \"Postman Air\",\n  \"aircraft\": \"Airbus A320\",\n  \"seatCapacity\": 180,\n  \"scheduledDepartureTime\": \"2026-12-01T10:00:00Z\",\n  \"scheduledArrivalTime\": \"2026-12-01T14:00:00Z\",\n  \"departureTime\": \"2026-12-01T10:30:00Z\",\n  \"arrivalTime\": \"2026-12-01T14:30:00Z\",\n  \"economyPrice\": 130.0,\n  \"premiumEconomyPrice\": 190.0,\n  \"businessPrice\": 330.0,\n  \"firstClassPrice\": 510.0\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const flightId = (pm.collectionVariables.get('flightId') || '').trim();",
                  "const guidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
                  "if (!guidPattern.test(flightId)) {",
                  "  throw new Error('Set collection variable flightId to a valid GUID before running this request.');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get comments by flight",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/flights/{{flightId}}/comments"
          }
        },
        {
          "name": "Create boarding pass payment session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/flights/{{flightId}}/boarding-passes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seat\": 0,\n  \"returnPath\": \"/payment/success\"\n}"
            }
          }
        },
        {
          "name": "Get boarding guides by flight",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/flights/{{flightId}}/boarding-guides"
          }
        },
        {
          "name": "Create boarding guide (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/flights/{{flightId}}/boarding-guides",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": \"{{flightId}}\",\n  \"description\": \"Test boarding guide\",\n  \"opensAt\": \"2026-12-01T08:00:00Z\",\n  \"closesAt\": \"2026-12-01T09:30:00Z\",\n  \"imageUrls\": [],\n  \"videoUrls\": []\n}"
            }
