  "item": [
    {
      "name": "01 - Registration, Login & Authorization",
      "item": [
        {
          "name": "Register Test User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\",\n  \"email\": \"{{userEmail}}\",\n  \"firstName\": \"{{userFirstName}}\",\n  \"lastName\": \"{{userLastName}}\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "sfc_refresh_token={{refreshToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Authorize User (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{regularUserId}}/authorize"
          }
        },
        {
          "name": "Create API Key (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"postman-key-{{$timestamp}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "02 - Authorization Scenarios",
      "item": [
        {
          "name": "No auth on protected endpoint (Api key or JWT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/flights"
          }
        },
        {
          "name": "API key on JWT protected endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": "{{baseUrl}}/news"
          }
        },
        {
          "name": "Wrong API key on API key protected endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{wrongApiKey}}"
              }
            ],
            "url": "{{baseUrl}}/flights"
          }
        },
        {
          "name": "User JWT on admin endpoint",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userAccessToken}}"
              }
            ],
            "url": "{{baseUrl}}/users"
          }
        },
       {
